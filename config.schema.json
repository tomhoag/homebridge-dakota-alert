{
  "pluginAlias": "DakotaAlert",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Configure your Dakota Alert RE-4k Plus motion sensors.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Platform Name",
        "type": "string",
        "default": "Dakota Alert",
        "required": true
      },
      "alerts": {
        "title": "Alerts",
        "type": "array",
        "minItems": 1,
        "maxItems": 2,
        "items": {
          "title": "Alert",
          "type": "object",
          "properties": {
            "label": {
              "title": "Name",
              "type": "string",
              "default": "Arrival",
              "required": true
            },
            "pin": {
              "title": "GPIO Pin",
              "type": "integer",
              "default": 4,
              "required": true,
              "minimum": 0,
              "maximum": 27
            }
          }
        }
      }
    }
  }
}
