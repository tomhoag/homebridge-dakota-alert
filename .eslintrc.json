{
  "parser": "@typescript-eslint/parser",
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended"
  ],
  "parserOptions": {
    "ecmaVersion": 2018,
    "sourceType": "module"
  },
  "ignorePatterns": ["dist"],
  "rules": {
    "quotes": ["warn", "single"],
    "indent": ["warn", 2, { "SwitchCase": 1 }],
    "semi": ["warn", "always"],
    "comma-dangle": ["warn", "always-multiline"],
    "eqeqeq": "warn",
    "curly": ["warn", "all"],
    "prefer-arrow-callback": ["warn"],
    "max-len": ["warn", 140],
    "no-console": ["warn"]
  }
}
